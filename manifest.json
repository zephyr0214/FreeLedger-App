{
    "name" : "自由记",
    "appid" : "__UNI__8E8C7CE",
    "description" : "本地记账 App",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    /* 5+App特有相关 */
    "app-plus" : {
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        "darkmode" : true,
        "themeLocation" : "theme.json",
        "safearea" : {
            "background" : "#F7F8FA",
            "backgroundDark" : "#000000",
            "bottom" : {
                "offset" : "none"
            }
        },
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },
        /* 模块配置 */
        "modules" : {
            "SQLite" : {}
        },
        /* ★ 强制移除的权限 ★
           官方文档：「如果应用使用了三方SDK（uts插件或uni原生插件）
           默认包含了一些Android权限，而实际可能不需要用到，
           则可以在 manifest.json 中的『安卓/iOS权限配置』
           ->『Android云打包权限配置』->『强制移除的权限』中添加要移除的权限」

           ★ 这就是「权限重复」报错的正解 ★
           云打包时，DCloud 的基础 SDK 会自动带上 WRITE_EXTERNAL_STORAGE 等权限；
           而 permissions 里手写的同名条目 + SDK 自带的那条
           -> 两条 uses-permission -> Gradle manifest merger 报 duplicated。

           所以正确做法不是「不写 permissions」（那不解决冲突），
           而是「写 permissions 的同时，用 permission.remove 明确把 SDK 带的那条去掉」。

           本应用的备份只写 App 私有目录 _doc/，完全用不到外部存储，
           三个存储权限都该去掉。 */
        "permission" : {
            "remove" : [
                "android.permission.READ_EXTERNAL_STORAGE",
                "android.permission.WRITE_EXTERNAL_STORAGE",
                "android.permission.READ_MEDIA_IMAGES"
            ]
        },
        /* 应用发布信息 */
        "distribute" : {
            /* android打包配置 */
            "android" : {
                /* ★ 这里只声明真正需要的权限 ★
                   不要在这里写存储权限：
                   基础 SDK 已经带了一份，再写一份就是重复声明。
                   要去掉 SDK 带的那份，用上面的 app-plus.permission.remove。 */
                "permissions" : [
                    "<uses-permission android:name=\"android.permission.INTERNET\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
                    "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>"
                ],
                /* 同一个「强制移除」的另一个字段名。
                   不同 HBuilderX 版本写的位置不一样，两个都配上，
                   哪个生效就用哪个，不会互相冲突。 */
                "permissionRemove" : [
                    "android.permission.READ_EXTERNAL_STORAGE",
                    "android.permission.WRITE_EXTERNAL_STORAGE",
                    "android.permission.READ_MEDIA_IMAGES"
                ]
            },
            /* ios打包配置 */
            "ios" : {
                "dSYMs" : false
            },
            /* SDK配置
               ★ 不要加 share ★
                 导出/分享功能已经整块删掉了，
                 加了只会让云打包多打一套微信/QQ SDK 进去，白白增大包体。
                 权限相关的问题看上面的 app-plus.permission.remove。 */
            "sdkConfigs" : {},
            "icons" : {
                "android" : {
                    "hdpi" : "unpackage/res/icons/72x72.png",
                    "xhdpi" : "unpackage/res/icons/96x96.png",
                    "xxhdpi" : "unpackage/res/icons/144x144.png",
                    "xxxhdpi" : "unpackage/res/icons/192x192.png"
                },
                "ios" : {
                    "appstore" : "unpackage/res/icons/1024x1024.png",
                    "ipad" : {
                        "app" : "unpackage/res/icons/76x76.png",
                        "app@2x" : "unpackage/res/icons/152x152.png",
                        "notification" : "unpackage/res/icons/20x20.png",
                        "notification@2x" : "unpackage/res/icons/40x40.png",
                        "proapp@2x" : "unpackage/res/icons/167x167.png",
                        "settings" : "unpackage/res/icons/29x29.png",
                        "settings@2x" : "unpackage/res/icons/58x58.png",
                        "spotlight" : "unpackage/res/icons/40x40.png",
                        "spotlight@2x" : "unpackage/res/icons/80x80.png"
                    },
                    "iphone" : {
                        "app@2x" : "unpackage/res/icons/120x120.png",
                        "app@3x" : "unpackage/res/icons/180x180.png",
                        "notification@2x" : "unpackage/res/icons/40x40.png",
                        "notification@3x" : "unpackage/res/icons/60x60.png",
                        "settings@2x" : "unpackage/res/icons/58x58.png",
                        "settings@3x" : "unpackage/res/icons/87x87.png",
                        "spotlight@2x" : "unpackage/res/icons/80x80.png",
                        "spotlight@3x" : "unpackage/res/icons/120x120.png"
                    }
                }
            },
            "splashscreen" : {
                "androidStyle" : "common",
                "useOriginalMsgbox" : false
            }
        }
    },
    /* 快应用特有相关 */
    "quickapp" : {},
    /* 小程序特有相关（本项目不做，保留占位） */
    "mp-weixin" : {
        "appid" : "",
        "setting" : {
            "urlCheck" : false
        },
        "usingComponents" : true
    },
    "vueVersion" : "3"
}
